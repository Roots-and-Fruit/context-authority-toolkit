{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cat-toolkit/term-section",
	"title": "CAT Term Section",
	"category": "cat-toolkit",
	"icon": "editor-table",
	"description": "An extractable glossary section with a slot heading and free inner blocks.",
	"textdomain": "context-authority-toolkit",
	"supports": {
		"html": false,
		"align": false,
		"layout": false
	},
	"attributes": {
		"section": {
			"type": "string",
			"enum": [ "what", "how", "examples", "mistakes", "takeaways" ],
			"default": "what"
		},
		"customHeading": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "cat-term-section-block-editor",
	"editorStyle": "cat-term-section-block-editor",
	"style": "cat-term-section-style"
}
